{
    "configurations": [
        {
            "name": "GCC-ARM",
            // 用 CMake 导出的编译数据库：IntelliSense 与真实编译参数完全一致
            "compileCommands": "${workspaceFolder}/build-gcc/Debug/compile_commands.json",
            "compilerPath": "C:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gcc.exe",
            "cStandard": "gnu11",
            "intelliSenseMode": "gcc-arm",
            // 下面两条仅作编译数据库缺失时的兜底
            "includePath": [
                "${workspaceFolder}/CONTRACT",
                "${workspaceFolder}/DEVICE",
                "${workspaceFolder}/APP_LOG",
                "${workspaceFolder}/IFACE",
                "${workspaceFolder}/APP",
                "${workspaceFolder}/BSP",
                "${workspaceFolder}/CMSIS",
                "${workspaceFolder}/DRIVERS",
                "${workspaceFolder}/FreeRTOS",
                "${workspaceFolder}/FreeRTOS/include",
                "${workspaceFolder}/FreeRTOS/portable/GCC/ARM_CM4F",
                "${workspaceFolder}/LIB/STM32F4xx_StdPeriph_Driver/inc",
                "${workspaceFolder}/LIB/STM32F4xx_StdPeriph_Driver/src"
            ],
            "defines": [
                "STM32F40_41xxx",
                "USE_STDPERIPH_DRIVER"
            ]
        }
    ],
    "version": 4
}
