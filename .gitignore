# 白名单策略：默认忽略工程内所有内容，只放行需要版本化的源码与文档
/*
!/.gitignore
!/README.md

# APP 只纳入 main.c（其余 stm32f4xx_it / conf 属于 ST 模板）
!/APP/
/APP/*
!/APP/main.c

# 契约与调度层（契约 / 状态机 / 显示 / 通用算法）
!/CONTRACT/

# 硬件抽象与机构执行层
!/DEVICE/

# 应用决策层（虚拟上位机 nav）
!/APP_LOG/

# 接入与人机层（auxiliary / screen）
!/IFACE/

# 自研应用层与 RTOS
!/BSP/
!/FreeRTOS/

# GCC + CMake 构建（换机器 / 换系统开发时要用，必须入库；产物在 build-gcc/ 自动被忽略）
!/CMakeLists.txt
!/CMakePresets.json
!/cmake/
!/STM32_CAN_CMD.code-workspace

# 编辑器配置：只纳入 IntelliSense / 调试 / 任务相关的必要配置
!/.vscode/
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json

# 以下内容不入版本库：CMSIS、LIB、DRIVERS（第三方库）、DOC、gongchuangsai-2026
# 构建产物（build-gcc/）由顶部 /* 规则统一忽略
