# 白名单策略：默认忽略工程内所有内容，只放行需要版本化的源码与文档
/*
!/.gitignore
!/README.md

# APP 只纳入 main.c（其余 stm32f4xx_it / conf 属于 ST 模板）
!/APP/
/APP/*
!/APP/main.c

# 自研应用层与 RTOS
!/BSP/
!/FreeRTOS/
!/Mycode/

# 编辑器配置：只纳入 IntelliSense / 调试 / 任务相关的必要配置
!/.vscode/
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json

!/PRJ/
/PRJ/*
!/PRJ/STM32_CAN_CMD.code-workspace

# 以下内容不入版本库：CMSIS、LIB、DRIVERS（第三方库）
# PRJ 其余内容（构建产物、EIDE 缓存）、PRJ/.vscode（Keil Assistant 自动生成）、DOC、gongchuangsai-2026
