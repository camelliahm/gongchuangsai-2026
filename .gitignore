# 白名单策略：默认忽略工程内所有内容，只放行需要版本化的源码与文档
/*
!/.gitignore
!/README.md
!/build.sh

# 契约与调度层（契约 / 状态机 / 显示 / 通用算法）
!/CONTRACT/

# 硬件抽象与机构执行层
!/DEVICE/

# 应用决策层（虚拟上位机 nav）
!/APP_LOG/

# 接入与人机层（auxiliary / screen）
!/IFACE/

# 自研应用层（Emm_V5 / can / board 头等）
!/BSP/

# 驱动（fifo 等）
!/DRIVERS/

# POSIX 本机模拟（Linux 构建；源码入库，build/ 构建产物忽略）
!/posix/
/posix/build/

# 编辑器配置：只纳入 IntelliSense / 调试 / 任务相关的必要配置
!/.vscode/
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/STM32_CAN_CMD.code-workspace

# 以下内容不入版本库：DOC
