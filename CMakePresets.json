{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "GCC Debug (-Og -g3)",
            "description": "日常开发：保留完整调试信息，编译器不优化，便于单步调试",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-gcc/Debug",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "GCC Release (-Os)",
            "description": "体积优先：-Os，发布构建",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-gcc/Release",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
